# =============================================================================
# Mini 공용 환경 변수 (.env.example)
# =============================================================================
# 사용법:
#   1. cp .env.example .env
#   2. 아래 값을 실제 키로 교체
#   3. .env 는 .gitignore 에 포함되어 있음 (절대 커밋 금지)
#
# 로드 우선순위:
#   lunch-optimizer/ · NLP/nlp_mvp/ 등 하위 프로젝트는
#   상위 경로 (Mini/.env) 를 기본으로 읽음.
#   필요 시 하위 .env 로 override 가능.
# =============================================================================

# -----------------------------------------------------------------------------
# Docker 포트 매핑 (다른 Compose 프로젝트와 충돌 방지)
# -----------------------------------------------------------------------------
# 다른 프로젝트가 같은 포트를 점유하고 있다면 아래 값을 변경.
# 예: WEB_PORT=3010 / LUNCH_API_PORT=8010 등
WEB_PORT=3000
LUNCH_API_PORT=8000
NLP_API_PORT=8001
OLLAMA_PORT=11434
HTTP_PORT=80
HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Ollama 모드 — 호스트 Mac vs Docker 컨테이너
# -----------------------------------------------------------------------------
# 기본 (권장): 호스트 Mac에 설치된 Ollama 사용 — Metal GPU 가속, 5–10배 빠름
#   설치:  brew install ollama && brew services start ollama
#   모델:  ollama pull qwen2.5:7b-instruct
#   nlp-api 컨테이너에서 호스트 Ollama 접속:
#     LUNCHMENU_OLLAMA_URL=http://host.docker.internal:11434  (아래 기본값)
#
# 대체: Docker 컨테이너 ollama 사용 (Linux 또는 호스트 Ollama 미설치 시)
#   기동:  docker compose --profile docker-llm up -d
#   변경:  LUNCHMENU_OLLAMA_URL=http://ollama:11434
#
# ⚠️ 변수명이 OLLAMA_HOST가 아닌 LUNCHMENU_OLLAMA_URL인 이유:
#    호스트에서 `ollama serve`를 띄우면 셸이 OLLAMA_HOST=0.0.0.0:11434 를 export하는데,
#    이는 bind 주소(host:port)이지 URL이 아니므로, 컨테이너의 nlp-api 파이썬 코드가
#    이 값을 그대로 받으면 http:// 스킴이 빠진 잘못된 URL이 되어 호출 실패함.
#    프로젝트 네임스페이스 변수로 분리해 셸 환경 누수를 차단.
LUNCHMENU_OLLAMA_URL=http://host.docker.internal:11434

# -----------------------------------------------------------------------------
# 공공 API 키 (Mini/api/ 폴더의 PDF 에서 복사)
# -----------------------------------------------------------------------------

# 카카오 REST API (음식점 검색)
# 출처: Mini/api/maps/api.pdf
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 공공데이터포털 data.go.kr 통합 인증키
# (기상청 단기예보 + 에어코리아 + 식약처 모두 동일 키 사용)
# 출처: Mini/api/weather/기상청_단기예보.pdf, Mini/api/food/식약처_영양성분.pdf
DATA_GO_KR_API_KEY_ENCODED=your_encoded_key_here
DATA_GO_KR_API_KEY_DECODED=your_decoded_key_here

# 개별 별칭 (각 가이드의 명명 규칙 호환)
WEATHER_API_KEY=${DATA_GO_KR_API_KEY_DECODED}
AIR_KOREA_API_KEY=${DATA_GO_KR_API_KEY_DECODED}

# 식품안전나라는 직접 발급 키 사용이 권장됨 (data.go.kr 키와 다름)
# 없으면 DATA_GO_KR_API_KEY_DECODED 를 fallback 으로 사용
# 발급: https://openapi.foodsafetykorea.go.kr/api/main.do
FOOD_SAFETY_API_KEY=your_food_safety_direct_key_here

# -----------------------------------------------------------------------------
# 영양 정보 Provider 라우팅 (data.go.kr 우선, 식품안전나라 폴백)
# -----------------------------------------------------------------------------
# data_go_kr (기본): apis.data.go.kr 식약처 영양 API 우선 사용
# food_safety: 식품안전나라(openapi.foodsafetykorea.go.kr) 만 사용
NUTRITION_PROVIDER=data_go_kr
# data_go_kr 실패 시 식품안전나라로 폴백 여부
NUTRITION_FALLBACK_FOOD_SAFETY=1
# 활용 신청한 정확한 endpoint 로 override 가능
DATA_GO_KR_NUTRITION_URL=https://apis.data.go.kr/1471000/FoodNtrCpntDbInfo01/getFoodNtrCpntDbInq01
# 검색 파라미터 키 (API 마다 다름. 예: FOOD_NM_KR, foodNm, DESC_KOR)
DATA_GO_KR_NUTRITION_NAME_PARAM=FOOD_NM_KR

# -----------------------------------------------------------------------------
# 사무실 좌표 (기본값: 서울시청)
# -----------------------------------------------------------------------------
OFFICE_LAT=37.5665
OFFICE_LNG=126.9780
SEARCH_RADIUS=500          # 검색 반경 (미터)

# 에어코리아 가까운 측정소 (Subtopic 2)
# 예: 종로구, 중구, 강남구, 서초구, ...
NEAREST_STATION_NAME=종로구

# -----------------------------------------------------------------------------
# 인증 / RBAC (Phase 13&14)
# -----------------------------------------------------------------------------
# JWT 서명 시크릿 — 32바이트 이상 url-safe random 권장
#   생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=__GENERATE_WITH_python_-c_secrets.token_urlsafe(32)__
JWT_EXPIRE_HOURS=24

# 초기 관리자 계정 (bootstrap_admin.py 가 사용)
# - 처음 1회 실행 시 신규 admin 계정 생성
# - 이메일이 이미 있으면 해당 사용자를 admin 으로 승격 (비밀번호는 그대로)
# - 비밀번호 재설정 강제: ADMIN_PASSWORD_RESET=1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__SET_STRONG_PASSWORD_8_PLUS_CHARS__
# ADMIN_PASSWORD_RESET=0

# -----------------------------------------------------------------------------
# 데이터베이스
# -----------------------------------------------------------------------------
# SQLite (MVP) — lunch-optimizer 의 database/ 폴더에 생성
DB_URL=sqlite:///./lunch-optimizer/database/mini.db

# NLP 쪽에서 참조하는 동일 DB 의 상대 경로
# (NLP/.env 의 MINI_DB_PATH 와 연동)
MINI_DB_PATH=../lunch-optimizer/database/mini.db

# -----------------------------------------------------------------------------
# FastAPI
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# CORS_ORIGINS — 콤마 구분, 와일드카드 X (FastAPI/CORSMiddleware 정확 매칭).
# 외부 배포 시 Firebase Hosting 도메인 + Cloudflare Tunnel 도메인 추가 필요. 예:
#   CORS_ORIGINS=http://localhost:3000,https://lunchmenu-mini.web.app,https://lunchmenu.your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:5173

# Slack notifications (Phase 3 follow-up)
# Create via https://api.slack.com/messaging/webhooks
# When unset, /api/notify/slack returns {sent:false, error:"not configured"}
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXX

# NLP FastAPI (Phase 5 Step 5) — 별도 포트로 분리 구동
NLP_API_PORT=8001
# 외부 배포 시 Firebase Hosting 도메인 추가 필요 (콤마 구분, 와일드카드 X)
NLP_API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:5173
# RAG chroma_store 자동 인덱싱 스킵 (운영 전에 CLI 로 직접 인덱싱할 경우 1)
NLP_SKIP_RAG_INDEX=0

# React 대시보드 — Vite 환경 변수 (개발 시 .env.local 로도 override 가능)
VITE_LUNCH_API=http://localhost:8000
VITE_NLP_API=http://localhost:8001
VITE_DEFAULT_USER_ID=1

# -----------------------------------------------------------------------------
# NLP 레이어 (Phase 5)
# -----------------------------------------------------------------------------
# Ollama (D3 RAG 챗봇 / D5 NLG 리포트)
# OLLAMA_HOST는 위 "Docker 포트 매핑" 섹션에서 설정됨
OLLAMA_MODEL=qwen3.5:9b
# 용도별 분리 (M9) — 둘 중 하나 비우면 OLLAMA_MODEL 로 fallback
# 추천: 채팅은 qwen3.5 계열, 리포트는 gemma4 계열
OLLAMA_MODEL_CHAT=qwen3.5:9b
OLLAMA_MODEL_REPORT=gemma4:e4b

# -----------------------------------------------------------------------------
# Gemini API (Phase 14) — Google Generative AI
# -----------------------------------------------------------------------------
# 키 발급: https://aistudio.google.com/app/apikey
# ⚠️ 절대 NEXT_PUBLIC_*에 넣지 말 것 (브라우저 노출 금지). 백엔드 nlp-api에서만 사용.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# 사용 모델 (gemini-2.5-pro: 품질 우선 / gemini-2.5-flash: 속도 우선)
GEMINI_MODEL_CHAT=gemini-2.5-pro
GEMINI_MODEL_REPORT=gemini-2.5-pro
GEMINI_MODEL_TOOLS=gemini-2.5-pro

# -----------------------------------------------------------------------------
# LLM Provider 선택 (gemini | ollama). 기능별로 분리.
# -----------------------------------------------------------------------------
# AI 상담 (/nlp/chatbot/chat, /chat/stream)
LLM_PROVIDER_CHAT=gemini
# 주간 NLG 리포트 (/nlp/reports/weekly/...)
LLM_PROVIDER_REPORT=gemini
# Tool Calling (/nlp/chatbot/chat/tools) — Gemini Function Calling 디폴트
LLM_PROVIDER_TOOLS=gemini
# 관리자 토큰 — 반드시 배포 전 랜덤 값으로 교체
# python -c "import secrets; print(secrets.token_urlsafe(32))"
NLP_ADMIN_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# 로컬 개발 모드 — 1로 설정 시 admin token 검증 스킵 (프로덕션에서는 0)
NLP_DEV_MODE=0
# 모델 스위칭 화이트리스트 (비우면 내장 기본값)
NLP_MODEL_WHITELIST=

# Hugging Face 임베딩 / 감성분석 모델
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
SENTIMENT_MODEL=nlp04/korean_sentiment_analysis_kcelectra

# ChromaDB (RAG 벡터 스토어)
CHROMA_DB_PATH=./NLP/nlp_mvp/rag_chatbot/chroma_store

# -----------------------------------------------------------------------------
# 로깅
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/mini.log
