# =============================================================================
# Mini — NLP FastAPI (port 8001)
# =============================================================================
# Heavy image (~2.5GB) because of transformers + torch CPU. First build
# downloads ~1.5GB of wheels; cached on subsequent builds.
#
# Build context: Mini/
# docker build -f docker/Dockerfile.nlp -t mini/nlp-api .
#
# Notes:
#   - Uses CPU-only torch (no CUDA) for dev/laptop deployment
#   - Models are downloaded on first request via HF Hub cache at /root/.cache/huggingface
#     which is persisted via a named volume
#   - Phase 5 MVP + Phase 6 research both import from NLP/
# =============================================================================

FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=Asia/Seoul \
    HF_HOME=/app/.cache/huggingface \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TRANSFORMERS_OFFLINE=0 \
    TOKENIZERS_PARALLELISM=false

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    curl \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install CPU-only torch first (heaviest dep; separate layer keeps cache warm)
RUN pip install --upgrade pip \
    && pip install --index-url https://download.pytorch.org/whl/cpu \
       "torch>=2.0,<3.0"

# Then install the NLP MVP + research deps
COPY NLP/nlp_mvp/requirements.txt /app/requirements-mvp.txt
COPY NLP/nlp_research/requirements.txt /app/requirements-research.txt
RUN pip install -r /app/requirements-mvp.txt \
    && pip install -r /app/requirements-research.txt

# Copy source (both mvp + research so imports resolve)
COPY NLP/nlp_mvp    /app/nlp_mvp
COPY NLP/nlp_research /app/nlp_research
COPY NLP/conftest.py /app/conftest.py

# Writable dirs for logs + chroma index + HF cache
RUN mkdir -p /app/logs /app/nlp_mvp/rag_chatbot/chroma_store /app/.cache/huggingface

# #6 Non-root user — principle of least privilege
RUN groupadd --system --gid 1001 appgroup \
    && useradd --system --uid 1001 --gid appgroup --home-dir /app --shell /usr/sbin/nologin appuser \
    && chown -R appuser:appgroup /app
USER appuser

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8001/nlp/health || exit 1

CMD ["uvicorn", "nlp_mvp.api.main:app", "--host", "0.0.0.0", "--port", "8001"]
