# =============================================================================
# Mini/NLP 환경 변수 (예시) — override 전용
# =============================================================================
# 기본적으로 상위 경로 `Mini/.env` 를 공용으로 사용합니다.
# 본 파일은 NLP 레이어 전용으로 override 가 필요한 경우에만 사용하세요.
# (NLP/shared/ 의 db·logger·ollama_client 는 상위 .env 를 자동 로드)
#
# 사용법: cp .env.example .env 후 필요한 값만 override

# --- 데이터 경로 (상위 .env 와 연동, Phase 0 결정 사항) ---
# Mini/NLP/ 기준 상대 경로 → Mini/lunch-optimizer/database/mini.db
MINI_DB_PATH=../lunch-optimizer/database/mini.db
CHROMA_DB_PATH=./nlp_mvp/rag_chatbot/chroma_store

# --- (선택) 상위 .env 값을 override 하고 싶은 경우 ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
# SENTIMENT_MODEL=nlp04/korean_sentiment_analysis_kcelectra

# --- NLP 전용 FastAPI (lunch-optimizer 의 8000 과 분리) ---
API_HOST=0.0.0.0
API_PORT=8001

# --- NLP 전용 로그 ---
LOG_LEVEL=INFO
LOG_FILE=./logs/nlp_mvp.log
