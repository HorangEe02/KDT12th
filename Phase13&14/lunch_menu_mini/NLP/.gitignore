# ===========================================
# Phase11/NLP 전용 .gitignore
# ===========================================

# 환경 변수 (실제 키 포함)
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv

# 학습 결과물 · 체크포인트
checkpoints/
*.pt
*.bin
*.safetensors
*.onnx

# 벡터 DB · 캐시
nlp_mvp/rag_chatbot/chroma_store/*
!nlp_mvp/rag_chatbot/chroma_store/.gitkeep
*.faiss
*.pkl
cache/

# 데이터 (민감 · 저작권)
nlp_mvp/data/raw/
nlp_mvp/data/reviews/
*.db
*.sqlite
*.sqlite3

# 로그
logs/
*.log

# Jupyter
.ipynb_checkpoints/

# Hugging Face 캐시
.cache/
~/.cache/huggingface/

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# W&B (시나리오 2)
wandb/
