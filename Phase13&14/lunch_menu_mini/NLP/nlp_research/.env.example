# Mini NLP Research env template
# cp .env.example .env and fill in as needed.

# Hugging Face (model downloads)
HF_HOME=~/.cache/huggingface
HF_HUB_DISABLE_TELEMETRY=1
# HF_TOKEN=hf_xxx     # uncomment for private/gated models

# Weights & Biases (optional logging)
# WANDB_API_KEY=xxxxx
# WANDB_PROJECT=mini-nlp-research
# WANDB_ENTITY=

# Ollama (reused for augmentation.gpt_augment)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# DB (reused from nlp_mvp — overrides default path)
# MINI_DB_PATH=../lunch-optimizer/database/mini.db
