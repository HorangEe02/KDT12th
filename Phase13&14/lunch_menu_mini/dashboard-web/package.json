{
  "name": "oneul-mwo-meokji-web",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https --experimental-https-key ./certs/localhost-key.pem --experimental-https-cert ./certs/localhost.pem -H 0.0.0.0",
    "build": "next build",
    "build:static": "bash scripts/build-static.sh",
    "preview:static": "npm run build:static && npx -y serve out -p 3001",
    "start": "next start",
    "lint": "eslint",
    "deploy:firebase": "npm run build:static && firebase deploy --only hosting",
    "deploy:firebase-preview": "npm run build:static && firebase hosting:channel:deploy preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.96.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
