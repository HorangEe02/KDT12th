# 오늘 뭐 먹지 — Next.js dashboard env template
# Copy to .env.local and adjust for your environment.

# Backend API base URLs
NEXT_PUBLIC_LUNCH_API=http://localhost:8000/api
NEXT_PUBLIC_NLP_API=http://localhost:8001

# Default user id used by Nutrition / Concierge pages
NEXT_PUBLIC_DEFAULT_USER_ID=1

# Kakao Maps JavaScript SDK 키 (프론트 지도 렌더링용)
# Kakao Developers → 내 애플리케이션 → 앱 키 → JavaScript 키
# 플랫폼 → Web → http://localhost:3000 등록 필수
NEXT_PUBLIC_KAKAO_MAP_KEY=YOUR_KAKAO_JS_KEY_HERE
