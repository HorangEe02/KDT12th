# ═══════════════════════════════════════
# 헬창지피티 API 키 설정
# 이 파일을 .env로 복사하여 실제 키를 입력하세요.
# ═══════════════════════════════════════

# 식품안전나라 Open API (https://www.foodsafetykorea.go.kr/api/newDataset498.do)
# 회원가입 후 "식품영양성분 DB(NEW)" API 인증키 발급
FOOD_SAFETY_API_KEY=your_food_safety_api_key_here

# 공공데이터포털 (https://www.data.go.kr)
# 회원가입 후 활용신청 → 인증키 발급
DATA_GO_KR_API_KEY=your_data_go_kr_api_key_here

# OpenAI API (비교 실험용, 선택사항)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama 설정
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_PATH=/Volumes/Corsair EX300U Media/.ollama/models
